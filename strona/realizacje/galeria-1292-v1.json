.length)return;idx=(i+items.length)%items.length;build().querySelector('.fudali-lb-i').src=src(items[idx]);ov.classList.add('on');document.body.style.overflow='hidden';ov.querySelector('.fudali-lb-x').focus();}function hide(){ov.classList.remove('on');document.body.style.overflow='';}document.addEventListener('click',function(ev){var t=ev.target;if(ov&&ov.classList.contains('on')){if(t.classList.contains('fudali-lb-x')||t===ov)hide();else if(t.classList.contains('fudali-lb-p'))show(idx-1);else if(t.classList.contains('fudali-lb-n'))show(idx+1);return;}var it=t.closest&&t.closest('.elementor-gallery-item');if(it){items=list();show(items.indexOf(it));}});document.addEventListener('keydown',function(e){if(!ov||!ov.classList.contains('on'))return;if(e.key==='Escape')hide();if(e.key==='ArrowLeft')show(idx-1);if(e.key==='ArrowRight')show(idx+1);});})();</script><style>.fudali-more{display:none;margin:28px auto 0;padding:16px 36px;border-radius:980px !important;border:2px solid #3E5A2C !important;background:transparent !important;color:#3E5A2C !important;font-weight:600;font-size:15px;min-height:48px;cursor:pointer;touch-action:manipulation}.fudali-more:hover,.fudali-more:focus-visible{background:#3E5A2C !important;color:#fff !important}</style><script>(function(){var N=24,expanded=false,btn;function w(){return document.querySelector('.elementor-widget-gallery');}function vis(){var g=w();if(!g)return[];return Array.prototype.filter.call(g.querySelectorAll('.elementor-gallery-item'),function(e){return e.offsetParent!==null;});}function update(){var g=w();if(!g)return;var it=vis();if(expanded||it.length<=N){g.style.maxHeight='';g.style.overflow='';if(btn)btn.style.display='none';return;}var gr=g.getBoundingClientRect(),r=it[N-1].getBoundingClientRect();g.style.maxHeight=Math.ceil(r.bottom-gr.top+12)+'px';g.style.overflow='hidden';if(!btn){btn=document.createElement('button');btn.type='button';btn.className='fudali-more';btn.textContent='Pokaż więcej zdjęć';btn.addEventListener('click',function(){expanded=true;update();window.dispatchEvent(new Event('resize'));});g.parentNode.insertBefore(btn,g.nextSibling);}btn.style.display='block';}function pre(){var g=w();if(g&&!expanded&&!g.style.maxHeight){g.style.maxHeight='2600px';g.style.overflow='hidden';}}pre();[800,1600,3000,5000].forEach(function(t){setTimeout(update,t);});window.addEventListener('load',function(){setTimeout(update,500);});window.addEventListener('resize',function(){if(!expanded)setTimeout(update,400);});document.addEventListener('click',function(e){if(e.target.closest&&e.target.closest('.elementor-gallery-title')){setTimeout(update,700);setTimeout(update,1500);}});})();</script>"}, "elements": []}]}]}