{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node biuro/build.mjs",
  "outputDirectory": "biuro/dist",
  "ignoreCommand": "sh scripts/vercel-ignore.sh",
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "zespol/sesje.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
